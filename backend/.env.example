# Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGODB_DATABASE=ai_tutor_dev
MONGODB_SERVER_TIMEOUT_MS=5000

# Authentication & Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=access_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Limits
MAX_SOURCES_PER_REQUEST=5
MAX_DOWNLOAD_SIZE_BYTES=2097152
MAX_EXTRACTED_CHARS=100000
MAX_CHUNKS_PER_SOURCE=100
SCRAPE_TIMEOUT_SECONDS=20
CHUNK_SIZE=200
CHUNK_OVERLAP=30

# GraphRAG Settings
RAG_MODE=vector
GRAPH_RAG_ENABLED=false
GRAPH_MAX_HOPS=2
GRAPH_MAX_ENTITIES=20
GRAPH_MAX_RELATIONSHIPS=30
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_GRAPH_WEIGHT=0.4
GRAPH_EXTRACTION_BATCH_SIZE=5
GRAPH_RETRIEVAL_TIMEOUT=5
